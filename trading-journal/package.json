{
  "name": "trading-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint src tests dev netlify --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:share": "vite build --mode share",
    "build:e2e-cloud": "VITE_SUPABASE_URL=https://e2e-mock.supabase.co VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_e2e vite build --outDir dist-e2e-cloud --emptyOutDir",
    "build:single": "tsc -b && node scripts/build-single.mjs",
    "budget": "node scripts/bundleBudget.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "idb-keyval": "^6.2.2",
    "lightweight-charts": "5.2.1",
    "lucide-react": "latest",
    "motion": "^13.4.6",
    "radix-ui": "latest",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@electric-sql/pglite": "0.3.16",
    "@eslint/js": "latest",
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6",
    "typescript-eslint": "latest",
    "vite": "^8",
    "vitest": "latest"
  }
}
