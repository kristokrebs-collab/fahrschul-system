# ── Client (public, inlined into the bundle by Vite) ─────────────────────────────────────────────
# Without both values the app stays local-only (isCloudAvailable() === false).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server (Netlify: mark as secret, scope "Functions"; NEVER with a VITE_ prefix) ───────────────
# Supabase service access (sb_secret_…)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# Trial length in days (default 14)
TRIAL_DAYS=

# AES-256-GCM key for exchange API secrets: openssl rand -base64 32
# Rotation: add EXCHANGE_ENC_KEY_V2 (new blobs use the highest version, old ones keep decrypting).
EXCHANGE_ENC_KEY_V1=

# Origin of the site, e.g. https://example.netlify.app (CORS of the optional Binance proxy, redirects)
SITE_ORIGIN=
# Scheduled exchange sync on/off (true/false)
SYNC_CRON_ENABLED=
# Share of client error reports stored, 0–1
LOG_SAMPLE_RATE=

# Optional: Premium LLM wording of the coach (only computed facts are sent)
ANTHROPIC_API_KEY=
COACH_MODEL=

# Hyblock (optional)
HYBLOCK_API_KEY=
HYBLOCK_BASE_URL=
HYBLOCK_AUTH_HEADER=
