# ── Client (public, inlined into the bundle by Vite) ─────────────────────────────────────────────
# Without both values the app stays local-only (isCloudAvailable() === false).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional OAuth buttons in the login sheet (enable the providers in Supabase Auth first): google,github,apple,discord
VITE_SUPABASE_OAUTH_PROVIDERS=
# Rechtliches (SETUP.md „Rechtliches“) – the OPERATOR's own data and documents; the app invents nothing and shows a
# marked placeholder for whatever is missing. Impressum data (address lines separated by "|"):
VITE_LEGAL_OPERATOR=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_PHONE=
VITE_LEGAL_REPRESENTATIVE=
VITE_LEGAL_REGISTER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_RESPONSIBLE=
# Your own pages (https, or a path on this site); IMPRESSUM_URL replaces the in-app Impressum, WIDERRUF_URL is optional
# (else the Widerrufsbelehrung is part of the AGB)
VITE_LEGAL_IMPRESSUM_URL=
VITE_LEGAL_DATENSCHUTZ_URL=
VITE_LEGAL_AGB_URL=
VITE_LEGAL_WIDERRUF_URL=

# ── Server (Netlify: mark as secret, scope "Functions"; NEVER with a VITE_ prefix) ───────────────
# Supabase service access (sb_secret_…)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# Trial length in days (default 14)
TRIAL_DAYS=
# P10 (optional): trial without a card (true/false, default false), Stripe Tax in Checkout (true/false, default false),
# trial via a referral link in days (default 30), credit for the referrer per paying referral in cents (default 1000)
STRIPE_TRIAL_CARDLESS=
STRIPE_AUTOMATIC_TAX=
REFERRAL_TRIAL_DAYS=
REFERRAL_REWARD_CENTS=

# AES-256-GCM key for exchange API secrets: openssl rand -base64 32
# Rotation: add EXCHANGE_ENC_KEY_V2 (new blobs use the highest version, old ones keep decrypting and are re-encrypted
# on use and by the cron; remove V1 once the cron log shows "keys":{…"remaining":0}).
EXCHANGE_ENC_KEY_V1=

# Origin of the site, e.g. https://example.netlify.app (CORS of the optional Binance proxy, redirects)
SITE_ORIGIN=
# Scheduled exchange sync on/off (true/false)
SYNC_CRON_ENABLED=
# Share of client error reports stored by /api/v1/log, 0–1 (default 1)
LOG_SAMPLE_RATE=
# Secret key for IP pseudonyms in audit_log / rate limits (HMAC): openssl rand -base64 32. Optional – without it the
# key is derived from SUPABASE_SECRET_KEY. Scope Functions, secret.
IP_HASH_PEPPER=

# Optional: Premium LLM wording of the coach (only computed facts are sent)
ANTHROPIC_API_KEY=
COACH_MODEL=
ROUTER_MODEL=
# Optional: model for the screenshot import (vision); default = COACH_MODEL, then claude-opus-5-5
VISION_MODEL=

# Optional: e-mail alarm with the app closed (F21, SETUP.md 6.1). Resend API key (secret, scope Functions) and the sender
# ("Name <alarm@your-domain>", the domain verified at Resend). Without both, the schedule does nothing and the app says "Einrichtung nötig".
RESEND_API_KEY=
ALERT_FROM=

# Hyblock (optional)
HYBLOCK_API_KEY=
HYBLOCK_BASE_URL=
HYBLOCK_AUTH_HEADER=
