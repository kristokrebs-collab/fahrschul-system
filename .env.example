# =============================================================================
# Fahrschule Krebs Social Autopilot - Beispielkonfiguration
# =============================================================================
# Diese Datei enthaelt KEINE echten Secrets und wird versioniert.
# Kopieren nach `.env` (nicht versioniert) und mit echten Werten fuellen.
#
# Alle Secrets werden ausschliesslich serverseitig gelesen. Es gibt keinen
# Build-Schritt, der sie in das Frontend-Bundle uebernimmt.
# =============================================================================

# --- Kern ---------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:8080

# Pfad zur SQLite-Datei (persistentes Volume in Produktion!)
DATABASE_PATH=./data/autopilot.db

# --- Sicherheit ---------------------------------------------------------
# 32 Byte, hex-kodiert (64 Zeichen). Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Verschluesselt Integrations-Tokens at rest (AES-256-GCM).
ENCRYPTION_KEY=

# Signiert Session-Cookies. Gleiche Erzeugung wie oben.
SESSION_SECRET=

# Initialer Owner-Account. Wird NUR beim allerersten Start angelegt und
# danach ignoriert. Passwort nach dem ersten Login aendern.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Cookies nur ueber HTTPS ausliefern (in Produktion IMMER true).
COOKIE_SECURE=true

# --- Instagram / Facebook (Meta Graph API) ------------------------------
# Benoetigt: Instagram Professional Account + verknuepfte Facebook-Seite.
# Berechtigungen: instagram_basic, instagram_content_publish,
#   instagram_manage_comments, instagram_manage_insights, pages_show_list,
#   pages_read_engagement, business_management
META_GRAPH_VERSION=v21.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# --- TikTok Content Posting API -----------------------------------------
# Berechtigungen: video.publish, video.list, user.info.basic
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- YouTube Data API v3 ------------------------------------------------
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Higgsfield (Medienarchiv-Import) -----------------------------------
# Optional. Ohne Key wird das Archiv ueber den offline JSONL-Export importiert.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# --- Betrieb ------------------------------------------------------------
LOG_LEVEL=info
# Scheduler/Worker in diesem Prozess starten (bei mehreren Instanzen nur auf einer!)
ENABLE_WORKERS=true
# Backup-Zielverzeichnis
BACKUP_DIR=./data/backups
# Aufbewahrungsdauer fuer Inbox-Nachrichten in Tagen (DSGVO-Datenminimierung)
INBOX_RETENTION_DAYS=180
