# Kopieren nach .env und lokal anpassen. Niemals echte Secrets committen.

# --- Postgres (lokal via docker-compose) ---
DATABASE_URL=postgres://fahrschul:fahrschul_dev_pw@localhost:5432/fahrschul_dev
DATABASE_URL_TEST=postgres://fahrschul:fahrschul_dev_pw@localhost:5432/fahrschul_test

POSTGRES_USER=fahrschul
POSTGRES_PASSWORD=fahrschul_dev_pw
POSTGRES_DB=fahrschul_dev

# --- API ---
API_PORT=4000
SESSION_SECRET=change-me-in-real-env-min-32-chars-long
COOKIE_SECURE=false

# --- TOTP / MFA ---
TOTP_ISSUER="Fahrschule Krebs"

# --- Integrationen (alle mock in dieser Umgebung, siehe docs/integration-gaps.md) ---
NOTIFICATIONS_MODE=mock
CALENDAR_MODE=mock
BANK_FEED_MODE=mock
DOCUMENT_STORAGE_MODE=mock
CRM_WEBHOOK_MODE=mock
