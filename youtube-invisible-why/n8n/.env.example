# Copy to .env and fill in what you already have — docker-compose.yml reads
# this file automatically. None of these are required just to start n8n and
# click around the imported workflows; you'll need them before nodes that
# reference them will actually succeed. Secrets like the Anthropic/
# ElevenLabs API keys and the YouTube OAuth client are NOT set here — those
# go into n8n's own encrypted credential store via the UI (Settings >
# Credentials), never into a plaintext .env file. See README.md for the
# full credential table.

# YouTube Data API key — only powers the optional competitor-upload trend
# signal node (it has continueOnFail set, so this can stay empty at first)
YOUTUBE_API_KEY=

# The ElevenLabs voice ID you land on after cloning/designing a voice
# (docs/SETUP.md's ElevenLabs section)
ELEVENLABS_VOICE_ID=

# Slack incoming webhook URL for review/analytics notifications
SLACK_WEBHOOK_URL=

# Timezone for the schedule triggers (weekly research run, weekly
# analytics report) — affects when "0 6 * * 1" etc. actually fire
GENERIC_TIMEZONE=UTC
