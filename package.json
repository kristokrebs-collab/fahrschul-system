{
  "name": "fahrschul-krebs-social-autopilot",
  "version": "1.0.0",
  "private": true,
  "description": "Social Media Autopilot fuer Fahrschule Krebs GmbH (Fulda / Bad Hersfeld)",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "tsc -p tsconfig.json && node --experimental-sqlite dist/server.js",
    "migrate": "node --experimental-sqlite dist/cli/migrate.js",
    "seed": "node --experimental-sqlite dist/cli/seed.js",
    "import:higgsfield": "node --experimental-sqlite dist/cli/import-higgsfield.js",
    "backup": "node --experimental-sqlite dist/cli/backup.js",
    "restore": "node --experimental-sqlite dist/cli/restore.js",
    "e2e": "node --experimental-sqlite dist/cli/e2e.js",
    "test": "npm run build && node --experimental-sqlite --test \"dist/tests/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
