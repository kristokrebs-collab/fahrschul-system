{
  "name": "fahrschul-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Fahrschule Krebs – Produktionsplattform (Prompt 0: Gemeinsame Plattform)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/with-env.mjs pnpm -r test",
    "test:api": "node scripts/with-env.mjs pnpm --filter @fahrschul/api test",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @fahrschul/database migrate",
    "db:seed": "node scripts/with-env.mjs pnpm --filter @fahrschul/database seed",
    "dev:api": "node scripts/with-env.mjs pnpm --filter @fahrschul/api dev",
    "dev:student": "pnpm --filter @fahrschul/student dev",
    "dev:office": "pnpm --filter @fahrschul/office dev",
    "dev:instructor": "pnpm --filter @fahrschul/instructor dev",
    "dev:finance": "pnpm --filter @fahrschul/finance dev",
    "dev:totp": "node scripts/dev-totp.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
