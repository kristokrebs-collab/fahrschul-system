{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83"
      ]
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server@3.4.2"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "glance": {
      "command": "npx",
      "args": [
        "-y",
        "glance-mcp@1.1.0"
      ]
    },
    "repomix": {
      "command": "npx",
      "args": [
        "-y",
        "repomix@1.18.1",
        "--mcp"
      ]
    },
    "elevenlabs": {
      "type": "http",
      "url": "https://api.elevenlabs.io/v1/mcp"
    },
    "kapso": {
      "type": "http",
      "url": "https://app.kapso.ai/mcp",
      "headers": {
        "X-API-Key": "${KAPSO_API_KEY}"
      }
    }
  }
}
