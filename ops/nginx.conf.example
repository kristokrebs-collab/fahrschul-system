# Beispiel für einen Reverse-Proxy mit TLS vor dem Autopilot.
#
# Der Dienst selbst spricht kein TLS und bindet nur auf 127.0.0.1.
# TLS, Zertifikate und eine zusätzliche Login-Sperre gehören hierher.

# Sperre gegen Rateversuche am Login, zusätzlich zum Limit in der Anwendung.
limit_req_zone $binary_remote_addr zone=fk_login:10m rate=6r/m;

server {
    listen 80;
    server_name autopilot.fahrschule-krebs.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name autopilot.fahrschule-krebs.example;

    ssl_certificate     /etc/letsencrypt/live/autopilot.fahrschule-krebs.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/autopilot.fahrschule-krebs.example/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Medienuploads brauchen etwas Luft.
    client_max_body_size 20m;

    location /api/auth/login {
        limit_req zone=fk_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Veroeffentlichungen an Meta koennen mehrere Minuten dauern.
        proxy_read_timeout 600s;
    }
}
