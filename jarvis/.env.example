# ── JARVIS Konfiguration ──────────────────────────────────────────────────
# Kopiere diese Datei nach .env und trage deine Werte ein.
# .env gehört NICHT ins Repository (siehe .gitignore).

NODE_ENV=production
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787
JARVIS_DATA_DIR=./data

# Pflicht für verschlüsselte Erinnerungen und Zugangsdaten.
# Erzeugen mit:  npm run jarvis -- keygen
JARVIS_MASTER_KEY=
JARVIS_SESSION_SECRET=

# Sprachmodell. Ohne Schlüssel läuft JARVIS im Quellen-Modus:
# Suche, Zitate, Erinnerungen und Aufgaben funktionieren, freie Antworten nicht.
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
JARVIS_MODEL_FAST=claude-haiku-4-5

# Embeddings: none | local-lexical | voyage | openai | ollama
#   local-lexical  offline, ohne Download, erkennt keine Synonyme
#   ollama         lokal und semantisch (empfohlen):  ollama pull nomic-embed-text
#   voyage/openai  semantisch, sendet Textausschnitte an den Anbieter
JARVIS_EMBEDDINGS=local-lexical
VOYAGE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_EMBED_MODEL=

# Schwestersysteme – ausschliesslich lesend.
SOCIAL_AUTOPILOT_URL=
SOCIAL_AUTOPILOT_TOKEN=
FINANCE_CRYPTO_URL=
FINANCE_CRYPTO_TOKEN=

# Ordner, die indexiert werden dürfen (kommagetrennt).
JARVIS_SOURCE_ROOTS=./sources

# Harter Schalter: blockiert alle ausgehenden Verbindungen.
JARVIS_OFFLINE=false
JARVIS_LOG_LEVEL=info

# Nur beim allerersten Start: legt das Besitzerkonto an.
JARVIS_OWNER_USERNAME=michael
JARVIS_OWNER_PASSWORD=
